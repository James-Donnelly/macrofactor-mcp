{
  "name": "macrofactor-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:init": "wrangler d1 execute macrofactor --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute macrofactor --file=./schema.sql --local",
    "ingest": "node scripts/ingest.mjs",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "doc-drift": "node scripts/doc-drift.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "0.33.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261114.1",
    "typescript": "^5.6.0",
    "wrangler": "4.162.0"
  }
}
